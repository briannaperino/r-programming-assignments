# This is the code for the data, boxplots and histogram for assignment #4
### input data ###
Frequency <- c(0.6,0.3,0.4,0.4, 0.2, 0.6, 0.3, 0.4, 0.9, 0.2)
BP <- c(103,87,32,42,59,109,78,205,135,176)
First <- c(1,1,1,1,0,0,0,0,NA,1)
Second <- c(0,0,1,1,0,0,1,1,1,1)
Final_Decision <- c(0,1,0,1,0,1,0,1,1,1)
### create data frame ###
df <- data.frame(Frequency, BP, First, Second, Final_Decision)
library(ggplot2)
### factor good and bad ###
df$First  <- factor(df$First)
df$Second <- factor(df$Second)
df$Final_Decision <- factor(df$Final_Decision)
### BOXPLOTS ###
## boxplot first doctor
first_bp <- ggplot(df, aes(x = First, y = BP)) +
  geom_boxplot(position = position_dodge(width = 0.7)) +
  labs(title = "BP by general doctor",
       x = "First",
       y = "BP") +
  scale_x_discrete(labels = c("First=0" = "good",
                              "First=1" = "bad")) + theme_minimal()
## boxplot second doctor
second_bp <- ggplot(df, aes(x = Second, y = BP)) +
  geom_boxplot(position = position_dodge(width = 0.7)) +
  labs(title = "BP by external doctor",
       x = "Second",
       y = "BP") +
  scale_x_discrete(labels = c("Second=0" = "good",
                              "Second=1" = "bad")) + theme_minimal()
## boxplot final doctor
final_bp <- ggplot(df, aes(x = Final_Decision, y = BP)) +
  geom_boxplot(position = position_dodge(width = 0.7)) +
  labs(title = "BP by head of emergency",
       x = "Final_Decision",
       y = "BP") +
  scale_x_discrete(labels = c("0" = "good",
                              "1" = "bad")) + theme_minimal()
### HISTOGRAM ###
hist_bp <- ggplot(df, aes(x = BP)) +
  geom_histogram(binwidth = 20, color = "black", fill = "grey") +
  labs(title = "Histogram of BP",
       x = "BP",
       y = "Count") + theme_minimal()
## all images together
library(ggpubr)
all_bp <- ggarrange(first_bp, second_bp, final_bp, hist_bp)
