#data
data(iris)
head(iris)
## Base R
# Scatter plot
## Scatter plot: Sepal.Length vs Petal.Length
plot(iris$Sepal.Length, iris$Petal.Length,
     main = "Base: Sepal.Length vs. Petal.Length",
     xlab = "Sepal.Length",
     ylab = "Petal.Length")

## Histogram: distribution of Petal.Width
hist(iris$Petal.Width,
     main = "Base: Distribution of Petal.Width",
     xlab = "Petal.Width")

## Lattice
library(lattice)
# Conditional scatter plot (small multiples)
xyplot(Petal.Length ~ Sepal.Length | Species,
       data = iris,
       main = "Lattice: Petal.Length vs. Sepal.Length by Species",
       xlab = "Sepal.Length",
       ylab = "Petal.Length")

# Box-and-whisker plot
bwplot(Petal.Width ~ Species,
       data = iris,
       main = "Lattice: Petal.Width by Species",
       xlab = "Species",
       ylab = "Petal.Width")


##ggplot
library(ggplot2)

# Scatter plot with smoothing
ggplot(iris, aes(x = Sepal.Length,
                 y = Petal.Length,
                 color = Species)) +
  geom_point() +
  geom_smooth(method = "lm") +
  labs(title = "ggplot2: Petal.Length vs. Sepal.Length with trend by Species",
       x = "Sepal.Length",
       y = "Petal.Length",
       color = "Species")

# Faceted histogram
ggplot(iris, aes(x = Petal.Width)) +
  geom_histogram(binwidth = 0.2, color = "white") +
  facet_wrap(~ Species) +
  labs(title = "ggplot2: Petal.Width distribution by Species",
       x = "Petal.Width",
       y = "Count")
